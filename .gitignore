# ========================
# Unity Generated Folders
# ========================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get huge
/[Mm]emoryCaptures/

# Recordings (Unity Recorder)
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code cache directories
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ========================
# VR & XR Specific
# ========================
# Oculus / Meta Quest SDK caches & local settings
/[Oo]culus/
/[Aa]ssets/Oculus/OculusProjectConfig.asset*
/[Aa]ssets/XR/Settings/Oculus*
*.ovrconfig

# OpenXR / XR Interaction Toolkit local cache
/[Aa]ssets/XR/Temp/

# SteamVR generated input bindings & local manifests (keep if sharing custom bindings)
# /actions.json
# /bindings_*.json
/steamvr_ue_editor_app.json

# Android / Quest Gradle & NDK build caches
/.utmp/
/Library/Bee/
/Assets/Plugins/Android/gradleTemplate.properties.bak

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db